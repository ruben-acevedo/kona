{
  "name": "kona",
  "productName": "Kona",
  "version": "0.1.0",
  "description": "A web browser with smart design and high performance",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "windows": "node scripts/windows.js",
    "test": "node scripts/test.js",
    "test:windows": "node scripts/windows.js --test",
    "icons": "electron scripts/icons.js",
    "dist": "node scripts/dist.js"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.11"
  },
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Rubén Acevedo"
  },
  "homepage": "https://github.com/ruben-acevedo/kona",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruben-acevedo/kona.git"
  },
  "build": {
    "appId": "com.ruben-acevedo.kona",
    "productName": "Kona",
    "copyright": "© 2026 Rubén Acevedo",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "page-preload.js",
      "ipc.js",
      "session-policy.js",
      "updater.js",
      "importer.js",
      "downloads.js",
      "context-menu.js",
      "extensions.js",
      "extension-shims.js",
      "passwords.js",
      "page-passwords.js",
      "reader.js",
      "reader-page.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "afterSign": "scripts/evs-sign.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Kona-${version}-update.${ext}",
      "signtoolOptions": {
        "publisherName": [
          "Rubén Acevedo"
        ]
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Kona",
      "uninstallDisplayName": "Kona",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "installer/uninstall.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ruben-acevedo",
        "repo": "kona",
        "releaseType": "release"
      }
    ],
    "extraFiles": [
      {
        "from": "build-extra/Kona Uninstaller.exe",
        "to": "Kona Uninstaller.exe"
      }
    ]
  }
}
